{
  "name": "powerpages-local",
  "version": "0.1.0",
  "description": "Local development server for Microsoft Power Pages with instant hot reload",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "powerpages-local": "./bin/powerpages-local.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chokidar": "^4.0.0",
    "connect": "^3.7.0",
    "js-yaml": "^4.1.0",
    "liquidjs": "^10.20.0",
    "picocolors": "^1.1.0",
    "sirv": "^3.0.0",
    "vite": "^5.4.21",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/connect": "^3.4.38",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "keywords": [
    "power-pages",
    "microsoft",
    "dataverse",
    "liquid",
    "local-development",
    "hot-reload"
  ]
}
