# ==============================================================================
# Power Pages Local Environment Configuration
# ==============================================================================
# Copy this file to '.env' and update the values for your Dataverse instance.
# Note: '.env' is gitignored and will never be committed.
# ==============================================================================

# Target Dataverse environment URL (e.g., https://org123.crm.dynamics.com)
DATAVERSE_ENVIRONMENT_URL=

# Target Power Pages Website ID (GUID)
# Run '.\status.ps1' or 'pac powerpages list' to see website GUIDs in your environment
POWERPAGES_WEBSITE_ID=

# Dataverse Solution Name (for tables & data model schema sync)
DATAVERSE_SOLUTION_NAME=

# Power Pages Model Version (2 for Enhanced Data Model)
POWERPAGES_MODEL_VERSION=2

# Path to the website directory
POWERPAGES_SITE_PATH=./src/orgfile-manager
