# Storage Backend: 'sqlite' (offline local development), 'bigquery' (direct GCP ADC), or 'auto'
DATA_BACKEND=sqlite

# GCP & BigQuery Settings (used when DATA_BACKEND=bigquery)
GCP_PROJECT_ID=prj-xyz-dev-veylo-0
BQ_CONFIG_DATASET=veylo_config
BQ_BRONZE_DATASET=veylo_bronze

# Optional explicit DB URL override (e.g. sqlite:///veylo_contracts.db)
DATABASE_URL=sqlite:///veylo_contracts.db

# Flask runtime settings
SECRET_KEY=local-dev-secret-key-replace-in-production
PORT=8080
FLASK_DEBUG=1
